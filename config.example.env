# MCP 图片生成 Server · 配置样例（cp 后填入密钥）
# 规格书第七节总表（名与默认值原样，未列出的即下方默认）+
# httpx 四段超时派生项（规格书五节"所有超时为配置项不硬编码"）。

# ---- 密钥（必填，缺失则启动 fail-fast 退出码 2）----
MCPACCESS_TOKEN=
AGNES_TOKEN=

# ---- 基础 ----
PORT=8000
IMAGE_DIR=/var/lib/mcp-imagegen/images

# ---- 并发与排队（等待上限 30s，到点返 busy）----
MAXCONCURRENCY=3
QUEUEWAIT_SEC=30

# ---- 超时预算（嵌套不等式自检：read ≤ 分档 ≤ 200 < 210 建议 < 220）----
TOTALBUDGETSEC=200
TIMEOUTSCHNELL=30
TIMEOUTKOLORSSMALL=60
TIMEOUTKOLORS_LARGE=120
# V2 更名自 PERSISTTIMEOUTSEC（纯改名）
PERSIST_TIMEOUT_IMAGE_SEC=30
PERSIST_TIMEOUT_VIDEO_SEC=120

# ---- 熔断（硬=429/402，软=连败 2 次；内存态，重启清零）----
CIRCUITHARDSEC=600
CIRCUITSOFTSEC=300

# ---- httpx 连接层 ----
HTTPXKEEPALIVESEC=25
HTTPXCONNECTSEC=5
HTTPXWRITESEC=5
HTTPXPOOLSEC=5
HTTPXMAXCONNECTIONS=10
HTTPXMAXKEEPALIVECONNECTIONS=4

# ==================== V2 增量（Agnes 单上游双模型）====================

# ---- Agnes 上游（唯一上游；Token 必填，缺失则启动 fail-fast 退出码 2）----
AGNES_BASE_URL=https://api.agnes-ai.cn
AGNES_TOKEN=

# ---- 上游模型 ID（可自定；留空 = 用内置默认）----
# 上游新增或更名模型时改这两项即可，无需改代码。
# 内置默认：agnes-image-2.5-flash / agnes-video-2.5-flash
AGNES_IMAGE_MODEL=
AGNES_VIDEO_MODEL=

# ---- 视频生成 ----
VIDEO_DIR=/var/lib/mcp-imagegen/videos
TIMEOUT_AGNES_IMAGE_SEC=60
VIDEO_SUBMIT_TIMEOUT_SEC=30
VIDEO_POLL_INTERVAL_SEC=2
VIDEO_QUERY_TIMEOUT_SEC=10

# ---- 视频任务表（内存态，重启即清）----
TASK_TTL_SEC=7200
TASK_MAX=100
