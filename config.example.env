# MCP 图片/视频生成 Server · 配置样例（cp 后填入 MCPACCESS_TOKEN）
#
# V5 模型：上游（第三方或自建）全部在管理面板配置，本文件只放「运行参数」，
# 不放任何上游地址与密钥（密钥落在 data/store.json，已被 .gitignore 排除）。
# 零上游配置时服务照常启动，但调用工具会明确返回「无可用提供方」而非静默失败。

# ---- 密钥（必填，缺失则启动 fail-fast 退出码 2）----
MCPACCESS_TOKEN=

# ---- 持久化（提供方 / 令牌 / 管理员口令；含密钥，切勿入库）----
STORE_PATH=data/store.json

# ---- 基础 ----
PORT=8000
IMAGE_DIR=/var/lib/mcp-imagegen/images
VIDEO_DIR=/var/lib/mcp-imagegen/videos

# ---- 并发与排队（等待上限 30s，到点返 busy）----
MAXCONCURRENCY=3
IMAGE_MAX_CONCURRENCY=8
VIDEO_MAX_CONCURRENCY=4
IMAGE_QUEUE_WAIT_SEC=30
VIDEO_QUEUE_WAIT_SEC=30
IMAGE_QUEUE_MAX=64
VIDEO_QUEUE_MAX=16
IMAGE_BATCH_CONCURRENCY=4

# ---- 超时预算（嵌套不等式自检：read ≤ 分档 ≤ 200 < 210 建议 < 220）----
TOTALBUDGETSEC=200
TIMEOUT_UPSTREAM_IMAGE_SEC=60
PERSIST_TIMEOUT_IMAGE_SEC=30
PERSIST_TIMEOUT_VIDEO_SEC=120

# ---- 熔断（硬=429/402，软=连败 2 次；内存态，重启清零）----
CIRCUITHARDSEC=600
CIRCUITSOFTSEC=300

# ---- httpx 连接层 ----
HTTPXKEEPALIVESEC=25
HTTPXCONNECTSEC=5
HTTPXWRITESEC=5
HTTPXPOOLSEC=5
HTTPXMAXCONNECTIONS=10
HTTPXMAXKEEPALIVE=4

# ---- 视频生成 ----
VIDEO_SUBMIT_TIMEOUT_SEC=30
VIDEO_POLL_INTERVAL_SEC=2
VIDEO_QUERY_TIMEOUT_SEC=10

# ---- 视频任务表（内存态，重启即清）----
TASK_TTL_SEC=7200
TASK_MAX=100
VIDEO_JOB_MAX=24
VIDEO_JOB_CONCURRENCY=8
VIDEO_JOB_MAX_WAIT_SEC=1800
VIDEO_SUBMIT_QUEUE_WAIT_SEC=600
VIDEO_SUBMIT_RETRY_MIN_SEC=20
VIDEO_SUBMIT_RETRY_MAX_SEC=90

# ---- 参考图 / 上传 ----
REFERENCE_MAX_MB=10
IMAGE_REFERENCE_MAX=4
VIDEO_REFERENCE_MAX=5
UPLOAD_MAX_MB=15
REF_CACHE_MAX_MB=32

# ---- 上游限速（每个提供方在面板单独设置，这里给默认值参考）----
#  per-provider limits.rps=10 / limits.burst=20：允许 20 张内短突发，之后 10 req/s 匀速；
#  脆弱上游可在面板把 rps 调小（如 1~2），无需改代码。
